# Private runtime configuration (FULL tier). On the server this lives OUTSIDE every webroot,
# readable only by the hosting account. Names only here — never real values.
APP_ENV=production

# Clerk — verify session tokens server-side (signature via JWKS, iss, exp/nbf, azp).
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=https://app.example.com

# Database — the runtime user has data rights only; schema changes use a separate migration user.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=
