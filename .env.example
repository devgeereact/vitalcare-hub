# Copy to .env.local for local development. Everything starting with VITE_ is PUBLIC:
# it is compiled into the JavaScript that every visitor downloads. Never put a secret here.

VITE_API_BASE_URL=/api

# FULL tier only. Publishable key (pk_...) — public by design. Never the secret key (sk_...).
VITE_CLERK_PUBLISHABLE_KEY=

# Deploy target for scripts/deploy-rsync.sh (host alias and path; no secrets).
# DEPLOY_TARGET=cpanel:/home/ACCOUNT/vitalcare.uk

# Public Cloudflare Turnstile site key for the contact form (never the secret key).
VITE_TURNSTILE_SITE_KEY=
