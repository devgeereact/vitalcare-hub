{
  "name": "vitalcare-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Care-sector training, certificates anyone can verify, and the staff compliance register behind them. Vitalcare Training Hub Ltd.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev.mjs --local",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm check:content && pnpm lint && pnpm typecheck && pnpm test && pnpm check:php && pnpm test:scripts && pnpm build",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev:web": "vite",
    "deploy:check": "bash scripts/deploy-rsync.sh \"$DEPLOY_TARGET\"",
    "deploy": "bash scripts/deploy-rsync.sh \"$DEPLOY_TARGET\" --go",
    "lint:php": "find backend -name '*.php' -not -path 'backend/vendor/*' -print0 | xargs -0 -n1 php -l > /dev/null",
    "test:php": "bash scripts/test-db.sh up && php backend/tests/run.php",
    "check:php": "pnpm lint:php && pnpm test:php && pnpm test:backup",
    "claims": "node scripts/claims.mjs",
    "check:content": "node scripts/claims.mjs --check && node scripts/check-copy.mjs",
    "test:backup": "bash backend/tests/backup.test.sh",
    "test:scripts": "python3 scripts/merge-htaccess.test.py && bash scripts/deploy-api.test.sh"
  },
  "dependencies": {
    "@clerk/react": "^6.18.3",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
