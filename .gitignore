# Dependencies and build output
node_modules/
dist/
backend/vendor/
coverage/

# Secrets and private config — never commit
.env
.env.*
!.env.example
!**/.env.example
backend/config/local.php
*.pem
*.key
*.p12
*.pfx

# Private project-local testing and recovery (see docs/RULES.md §6)
/.local-test/
/.local-state/
/.release/

# Backups and dumps never belong in Git
backups/
*.sql
*.sql.gz
# ...but numbered schema migrations are source code and must be tracked
!backend/migrations/*.sql

# Logs and OS/editor noise
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
